apiVersion: 1
prune: true
datasources:
- name: VictoriaMetrics
  uid: victoria-metrics
  type: prometheus
  access: proxy
  url: http://{{links.victoria-metrics.host}}:{{links.victoria-metrics.port}}
  isDefault: true
  editable: false
- name: Loki
  uid: loki
  type: loki
  access: proxy
  url: http://{{links.loki.host}}:{{links.loki.port}}
  editable: false
  jsonData:
    timeout: 60
    maxLines: 1000
    # OTLP logs keep the trace ID as structured metadata: link it to the trace in Tempo.
    derivedFields:
    - name: TraceID
      matcherType: label
      matcherRegex: trace_id
      datasourceUid: tempo
      url: '$${__value.raw}'
      urlDisplayLabel: View trace
- name: Tempo
  uid: tempo
  type: tempo
  access: proxy
  url: http://{{links.tempo.host}}:{{links.tempo.port}}
  editable: false
  jsonData:
    streamingEnabled:
      search: true
      metrics: true
    lokiSearch:
      datasourceUid: loki
    # From a span, open the logs of the same trace in Loki.
    tracesToLogsV2:
      datasourceUid: loki
      spanStartTimeShift: '-5m'
      spanEndTimeShift: '5m'
      tags:
      - key: service.name
        value: service_name
      customQuery: true
      query: '{$${__tags}} | trace_id="$${__trace.traceId}"'
